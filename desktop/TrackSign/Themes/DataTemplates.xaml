<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:TrackSign.Models"
                    xmlns:converters="clr-namespace:TrackSign.Converters">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <converters:SeverityToColorConverter x:Key="SeverityToColor"/>
    <converters:FileSizeConverter x:Key="FileSize"/>

    <DataTemplate DataType="{x:Type models:Finding}">
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                             Fill="{Binding Severity, Converter={StaticResource SeverityToColor}}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Severity, StringFormat='{}{0}'}"
                               FontWeight="SemiBold" FontSize="12"
                               Foreground="{Binding Severity, Converter={StaticResource SeverityToColor}}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Category}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Clause}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="Why it matters" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Fairer version" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding FairerVersion}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:Review}">
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Cursor="Hand">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Filename}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding CreatedAt}" Style="{StaticResource MutedText}" FontSize="12"/>
                        <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSize}}"
                                   Style="{StaticResource MutedText}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FlagCounts.High, StringFormat='{}{0} high'}"
                               Foreground="{StaticResource HighSeverityBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding FlagCounts.Medium, StringFormat='{}{0} med'}"
                               Foreground="{StaticResource MediumSeverityBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding FlagCounts.Low, StringFormat='{}{0} low'}"
                               Foreground="{StaticResource LowSeverityBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
