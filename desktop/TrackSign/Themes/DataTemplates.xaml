<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:TrackSign.Models"
                    xmlns:converters="clr-namespace:TrackSign.Converters">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <converters:SeverityToColorConverter x:Key="SeverityToColorLocal"/>
    <converters:FileSizeConverter x:Key="FileSizeLocal"/>

    <DataTemplate DataType="{x:Type models:Review}">
        <Border Style="{StaticResource HoverCard}" Padding="16" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Filename}" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ContractType}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="{Binding CreatedAt}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Border Background="{StaticResource SeverityHighBg}" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="{Binding FlagCounts.High, StringFormat='{}{0} high'}" FontSize="10"
                                   Foreground="{StaticResource SeverityHigh}"/>
                    </Border>
                    <Border Background="{StaticResource SeverityMediumBg}" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="{Binding FlagCounts.Medium, StringFormat='{}{0} med'}" FontSize="10"
                                   Foreground="{StaticResource SeverityMedium}"/>
                    </Border>
                    <Border Background="{StaticResource SeverityLowBg}" CornerRadius="10" Padding="8,3">
                        <TextBlock Text="{Binding FlagCounts.Low, StringFormat='{}{0} low'}" FontSize="10"
                                   Foreground="{StaticResource SeverityLow}"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="→" FontSize="14" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
