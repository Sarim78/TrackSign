<UserControl x:Class="TrackSign.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Account details for this workstation."
                       Style="{StaticResource MutedText}" Margin="0,6,0,24"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Account" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding UserName}" FontSize="16"/>
                    <TextBlock Text="{Binding UserEmail}" Style="{StaticResource MutedText}" Margin="0,4,0,12"/>
                    <TextBlock Text="{Binding Plan, StringFormat='Plan: {0}'}" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Support" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding CompanyName}"/>
                    <TextBlock Text="{Binding SupportEmail}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
