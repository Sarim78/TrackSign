<UserControl x:Class="TrackSign.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Export all" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,8"
                        Command="{Binding ExportAllCommand}" Margin="0,0,8,0"/>
                <Button Content="Upload new" Style="{StaticResource SmallPrimaryButton}" Command="{Binding StartUploadCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Review history" Style="{StaticResource PageTitle}" Margin="0"/>
                <TextBlock Text="{Binding ReviewCountLabel}" FontSize="13" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="12,16" Margin="0,0,0,16">
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" Style="{StaticResource DarkComboBox}" Width="160"
                          ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortMode}"/>
                <Grid DockPanel.Dock="Right" Width="240" Margin="0,0,12,0">
                    <TextBox Style="{StaticResource DarkTextBox}" Padding="28,8,10,8"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Mdl2Icon}" FontSize="12" HorizontalAlignment="Left"
                               Margin="10,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPill}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllFilter}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="High risk" Command="{Binding SetFilterCommand}" CommandParameter="High risk" Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPill}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighFilter}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="This month" Command="{Binding SetFilterCommand}" CommandParameter="This month" Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPill}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonthFilter}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding HasReviews, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="36" Background="{StaticResource TableHeaderBackground}" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="CONTRACT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="TYPE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="FLAGS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="SCORE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="DATE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </Grid>
                <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource BorderDefault}"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="16,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Previous" Style="{StaticResource GhostButton}" Command="{Binding PreviousPageCommand}"/>
                        <Button Content="Next" Style="{StaticResource GhostButton}" Command="{Binding NextPageCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ShowingText}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding PagedRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkCardButton}"
                                    Command="{Binding DataContext.OpenReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding ReviewId}">
                                <Grid Height="52" Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Filename}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ContractType}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FlagCounts.High}" Foreground="{StaticResource SeverityHigh}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding FlagCounts.Medium}" Foreground="{StaticResource SeverityMedium}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding FlagCounts.Low}" Foreground="{StaticResource SeverityLow}" FontSize="12"/>
                                    </StackPanel>
                                    <Border Grid.Column="4" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SeverityHighBg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RiskTone}" Value="medium">
                                                        <Setter Property="Background" Value="{StaticResource SeverityMediumBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RiskTone}" Value="low">
                                                        <Setter Property="Background" Value="{StaticResource SeverityLowBg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RiskScore}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SeverityHigh}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RiskTone}" Value="medium">
                                                            <Setter Property="Foreground" Value="{StaticResource SeverityMedium}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskTone}" Value="low">
                                                            <Setter Property="Foreground" Value="{StaticResource SeverityLow}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="5" Text="{Binding RelativeDate}" FontSize="12"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="48"
                Visibility="{Binding HasReviews, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE81C;" Style="{StaticResource Mdl2Icon}" FontSize="48"/>
                <TextBlock Text="No contracts reviewed" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Get started by uploading a contract" FontSize="13" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" Margin="0,8,0,16"/>
                <Button Content="Upload contract" Style="{StaticResource PrimaryButton}" Command="{Binding StartUploadCommand}"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
