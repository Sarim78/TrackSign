<UserControl x:Class="TrackSign.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Review history" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Open a past review or filter by risk and date."
                       Style="{StaticResource MutedText}" Margin="0,6,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="All" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        Command="{Binding SetFilterCommand}" CommandParameter="All"/>
                <Button Content="High risk" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        Command="{Binding SetFilterCommand}" CommandParameter="High risk"/>
                <Button Content="This month" Style="{StaticResource GhostButton}"
                        Command="{Binding SetFilterCommand}" CommandParameter="This month"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource HighSeverityBrush}" Margin="0,0,0,12"/>
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding FilteredReviews}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource LinkCardButton}"
                                Command="{Binding DataContext.OpenReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding ReviewId}">
                            <ContentPresenter Content="{Binding}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
