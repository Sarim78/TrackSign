<Window x:Class="TrackSign.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AppTitle}"
        Width="480" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <Image Source="{Binding LogoPath}" Height="48" Stretch="Uniform" Margin="0,0,0,20"/>
            <TextBlock Text="{Binding AppTitle}" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Sign in with your organization account to review contracts."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,0,0,28"/>

            <Button Content="Sign in with SSO"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoginCommand}"
                    Height="42"/>

            <TextBlock Text="Signing in..."
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"
                       Style="{StaticResource MutedText}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource HighSeverityBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,16,0,0"/>

            <TextBlock Text="Access is limited to authorized users. Login is required on every launch."
                       Style="{StaticResource MutedText}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,32,0,0"/>
        </StackPanel>
    </Grid>
</Window>
