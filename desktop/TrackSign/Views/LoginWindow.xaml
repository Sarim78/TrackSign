<Window x:Class="TrackSign.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AppTitle}"
        Width="450" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Opacity="0"
        Loaded="Window_Loaded">
    <Border Background="{StaticResource PageBackground}" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button Content="✕" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0" FontSize="12" Click="Close_Click"/>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                <Image Source="{Binding LogoPath}" Width="48" Height="48" Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}"/>
                <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource AccentColor}"
                        HorizontalAlignment="Center"
                        Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBlock Text="TS" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource WhiteBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="{Binding AppTitle}" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,8"/>
                <TextBlock Text="Sign in with your organization account to review contracts."
                           FontSize="13" Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>

                <Button Content="Sign in with SSO"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        Height="44" Margin="0,32,0,0"/>

                <TextBlock Text="Signing in..."
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="{StaticResource ErrorColor}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,16,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}"/>

                <StackPanel Visibility="{Binding DevMode, Converter={StaticResource BoolToVis}}" Margin="0,24,0,0">
                    <TextBlock Text="Development mode"
                               FontSize="11"
                               Foreground="{StaticResource WarningColor}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="devMode: true in Config/auth.json (change to false for production)"
                               FontSize="10"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Text="Access is limited to authorized users. Login is required on every launch."
                           FontSize="11"
                           Foreground="{StaticResource TextDark}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,24,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
