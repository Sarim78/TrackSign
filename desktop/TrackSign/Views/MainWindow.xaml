<Window x:Class="TrackSign.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TrackSign.Views"
        xmlns:vm="clr-namespace:TrackSign.ViewModels"
        Title="{Binding AppTitle}"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UploadViewModel}">
            <views:UploadView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,16">
                    <Image Source="{Binding LogoPath}" Height="32" Stretch="Uniform" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <TextBlock Text="Enterprise" Style="{StaticResource MutedText}" FontSize="12"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" Margin="8,0,8,2"/>
                    <TextBlock Text="{Binding UserEmail}" Style="{StaticResource MutedText}" FontSize="12" Margin="8,0,8,12"/>
                    <Button Content="Sign out" Style="{StaticResource GhostButton}"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>

                <StackPanel Margin="12,8">
                    <Button Content="Dashboard" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"/>
                    <Button Content="Upload contract" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateToCommand}" CommandParameter="Upload"/>
                    <Button Content="History" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateToCommand}" CommandParameter="History"/>
                    <Button Content="Settings" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateToCommand}" CommandParameter="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" Margin="0"/>
    </Grid>
</Window>
