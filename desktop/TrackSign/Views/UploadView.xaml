<UserControl x:Class="TrackSign.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Upload a contract" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="PDF files only. The backend extracts text and returns flagged clauses."
                       Style="{StaticResource MutedText}" Margin="0,6,0,24"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Contract file" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding BrowseFileCommand}"/>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding SelectedFileName, TargetNullValue='No file selected'}"
                                   Style="{StaticResource MutedText}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Contract type" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding ContractTypes}"
                              SelectedItem="{Binding ContractType, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <Button Content="Review contract"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ReviewContractCommand}"
                    HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding ScanningStatus}" Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource HighSeverityBrush}" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
