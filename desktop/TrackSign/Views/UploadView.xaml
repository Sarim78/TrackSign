<UserControl x:Class="TrackSign.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Upload a contract" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Upload a PDF and TrackSign will scan every clause." Style="{StaticResource PageSubtitle}"/>

            <TextBlock Text="What type of contract is this?" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
            <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding ContractTypes}"
                      SelectedItem="{Binding ContractType, Mode=TwoWay}" Margin="0,0,0,16"/>

            <Grid Height="280" Visibility="{Binding ShowDropZone, Converter={StaticResource BoolToVis}}"
                  AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave"
                  MouseLeftButtonUp="DropZone_Click" Cursor="Hand">
                <Border Background="{StaticResource CardBackground}" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSubtle}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Rectangle RadiusX="8" RadiusY="8" Fill="Transparent" StrokeDashArray="4 3" StrokeThickness="1">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Stroke" Value="{StaticResource BorderDefault}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource AccentColor}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE898;" Style="{StaticResource Mdl2Icon}" FontSize="48"/>
                    <TextBlock Text="Drop your contract here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="or click to browse files" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Text="Supported: PDF up to 20MB" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Visibility="{Binding ShowSelectedState, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="40" Height="48" CornerRadius="4" Background="{StaticResource SeverityHigh}">
                            <TextBlock Text="PDF" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource WhiteBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedFileName}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedFileSize, Converter={StaticResource FileSize}}" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="16" Height="16" Stroke="{StaticResource BorderDefault}" StrokeThickness="2"
                                 Visibility="{Binding ScanStep, Converter={StaticResource LessThanToVis}, ConverterParameter=1}"/>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Mdl2Icon}" FontSize="12" Foreground="{StaticResource SuccessColor}"
                                   Visibility="{Binding ScanStep, Converter={StaticResource GreaterThanToVis}, ConverterParameter=1}"/>
                        <Ellipse Width="16" Height="16" Fill="{StaticResource AccentColor}"
                                 Visibility="{Binding ScanStep, Converter={StaticResource IntEqualsToVis}, ConverterParameter=1}"/>
                        <TextBlock Grid.Column="1" Text="Upload file" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="16" Height="16" Stroke="{StaticResource BorderDefault}" StrokeThickness="2"
                                 Visibility="{Binding ScanStep, Converter={StaticResource LessThanToVis}, ConverterParameter=2}"/>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Mdl2Icon}" FontSize="12" Foreground="{StaticResource SuccessColor}"
                                   Visibility="{Binding ScanStep, Converter={StaticResource GreaterThanToVis}, ConverterParameter=2}"/>
                        <Ellipse Width="16" Height="16" Fill="{StaticResource AccentColor}"
                                 Visibility="{Binding ScanStep, Converter={StaticResource IntEqualsToVis}, ConverterParameter=2}"/>
                        <TextBlock Grid.Column="1" Text="Extract text" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="16" Height="16" Stroke="{StaticResource BorderDefault}" StrokeThickness="2"
                                 Visibility="{Binding ScanStep, Converter={StaticResource LessThanToVis}, ConverterParameter=3}"/>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Mdl2Icon}" FontSize="12" Foreground="{StaticResource SuccessColor}"
                                   Visibility="{Binding ScanStep, Converter={StaticResource GreaterThanToVis}, ConverterParameter=3}"/>
                        <Ellipse Width="16" Height="16" Fill="{StaticResource AccentColor}"
                                 Visibility="{Binding ScanStep, Converter={StaticResource IntEqualsToVis}, ConverterParameter=3}"/>
                        <TextBlock Grid.Column="1" Text="Analyze clauses" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="16" Height="16" Stroke="{StaticResource BorderDefault}" StrokeThickness="2"
                                 Visibility="{Binding ScanStep, Converter={StaticResource LessThanToVis}, ConverterParameter=4}"/>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Mdl2Icon}" FontSize="12" Foreground="{StaticResource SuccessColor}"
                                   Visibility="{Binding ScanStep, Converter={StaticResource GreaterThanToVis}, ConverterParameter=4}"/>
                        <Ellipse Width="16" Height="16" Fill="{StaticResource AccentColor}"
                                 Visibility="{Binding ScanStep, Converter={StaticResource IntEqualsToVis}, ConverterParameter=4}"/>
                        <TextBlock Grid.Column="1" Text="Generate report" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>

                    <Button Content="Review contract" Style="{StaticResource PrimaryButton}" Height="44"
                            Command="{Binding ReviewContractCommand}"/>
                    <Button Content="Remove file" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Command="{Binding RemoveFileCommand}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource ErrorColor}" Margin="0,12,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}"/>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="About the review" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="AI model" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="Claude Sonnet" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Checklist" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="General v1.0" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="Estimated time" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="Under 60 seconds" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                </Grid>
                <Border Height="1" Background="{StaticResource BorderLight}" Margin="0,0,0,16"/>
                <TextBlock Text="What we check" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding ChecklistItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentColor}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{StaticResource BorderLight}" Margin="0,8,0,16"/>
                <TextBlock Text="Security" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Your documents are encrypted in transit and never shared." FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                <TextBlock Text="Processing happens server-side and contract text is stored securely." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
