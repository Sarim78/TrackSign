<UserControl x:Class="TrackSign.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="Upload a contract" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Upload a PDF and TrackSign will scan every clause." Style="{StaticResource PageSubtitle}"/>

        <TextBlock Text="What type of contract is this?" FontSize="12" Foreground="{StaticResource TextSecondary}"
                   Margin="0,0,0,8"/>
        <ComboBox Style="{StaticResource DarkComboBox}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,20"
                  ItemsSource="{Binding ContractTypes}"
                  SelectedItem="{Binding ContractType, Mode=TwoWay}"/>

        <Grid Visibility="{Binding ShowDropZone, Converter={StaticResource BoolToVis}}"
              AllowDrop="True"
              Drop="DropZone_Drop"
              DragOver="DropZone_DragOver"
              DragLeave="DropZone_DragLeave"
              MouseLeftButtonUp="DropZone_Click"
              Cursor="Hand" Height="240">
            <Border Background="{StaticResource CardBackground}" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{StaticResource AccentGlowColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Rectangle RadiusX="8" RadiusY="8" Fill="Transparent" StrokeDashArray="4 3" StrokeThickness="1">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Stroke" Value="{StaticResource BorderDefault}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource AccentColor}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="↑" FontSize="32" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                <TextBlock Text="Drop your contract here" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="or click to browse" FontSize="12" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="PDF files up to 20MB" FontSize="11" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Encrypted and private. Your files are never shared."
                   FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"
                   Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                Visibility="{Binding ShowFileCard, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Remove" Style="{StaticResource GhostButton}" Command="{Binding RemoveFileCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Review contract" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ReviewContractCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="40" CornerRadius="4" Background="{StaticResource SeverityHigh}"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="PDF" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource WhiteBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedFileName}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedFileSize, Converter={StaticResource FileSize}}"
                                   FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✓" FontSize="14" Foreground="{StaticResource SuccessColor}"
                               Visibility="{Binding ScanStep, Converter={StaticResource GreaterThanToVis}, ConverterParameter=1}"/>
                    <Ellipse Width="14" Height="14" Stroke="{StaticResource AccentColor}" StrokeThickness="2"
                             StrokeDashArray="8 12" RenderTransformOrigin="0.5,0.5"
                             Visibility="{Binding ScanStep, Converter={StaticResource IntEqualsToVis}, ConverterParameter=1}">
                        <Ellipse.RenderTransform>
                            <RotateTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" Fill="{StaticResource TextDark}" HorizontalAlignment="Left" Margin="4,0,0,0"
                             Visibility="{Binding ScanStep, Converter={StaticResource LessThanToVis}, ConverterParameter=1}"/>
                    <TextBlock Grid.Column="1" Text="Uploading file" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✓" FontSize="14" Foreground="{StaticResource SuccessColor}"
                               Visibility="{Binding ScanStep, Converter={StaticResource GreaterThanToVis}, ConverterParameter=2}"/>
                    <Ellipse Width="14" Height="14" Stroke="{StaticResource AccentColor}" StrokeThickness="2"
                             StrokeDashArray="8 12" RenderTransformOrigin="0.5,0.5"
                             Visibility="{Binding ScanStep, Converter={StaticResource IntEqualsToVis}, ConverterParameter=2}">
                        <Ellipse.RenderTransform>
                            <RotateTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" Fill="{StaticResource TextDark}" HorizontalAlignment="Left" Margin="4,0,0,0"
                             Visibility="{Binding ScanStep, Converter={StaticResource LessThanToVis}, ConverterParameter=2}"/>
                    <TextBlock Grid.Column="1" Text="Extracting text" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✓" FontSize="14" Foreground="{StaticResource SuccessColor}"
                               Visibility="{Binding ScanStep, Converter={StaticResource GreaterThanToVis}, ConverterParameter=3}"/>
                    <Ellipse Width="14" Height="14" Stroke="{StaticResource AccentColor}" StrokeThickness="2"
                             StrokeDashArray="8 12" RenderTransformOrigin="0.5,0.5"
                             Visibility="{Binding ScanStep, Converter={StaticResource IntEqualsToVis}, ConverterParameter=3}">
                        <Ellipse.RenderTransform>
                            <RotateTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" Fill="{StaticResource TextDark}" HorizontalAlignment="Left" Margin="4,0,0,0"
                             Visibility="{Binding ScanStep, Converter={StaticResource LessThanToVis}, ConverterParameter=3}"/>
                    <TextBlock Grid.Column="1" Text="Analyzing clauses" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✓" FontSize="14" Foreground="{StaticResource SuccessColor}"
                               Visibility="{Binding ScanStep, Converter={StaticResource GreaterThanToVis}, ConverterParameter=4}"/>
                    <Ellipse Width="14" Height="14" Stroke="{StaticResource AccentColor}" StrokeThickness="2"
                             StrokeDashArray="8 12" RenderTransformOrigin="0.5,0.5"
                             Visibility="{Binding ScanStep, Converter={StaticResource IntEqualsToVis}, ConverterParameter=4}">
                        <Ellipse.RenderTransform>
                            <RotateTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="6" Height="6" Fill="{StaticResource TextDark}" HorizontalAlignment="Left" Margin="4,0,0,0"
                             Visibility="{Binding ScanStep, Converter={StaticResource LessThanToVis}, ConverterParameter=4}"/>
                    <TextBlock Grid.Column="1" Text="Generating report" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="This usually takes under 60 seconds." FontSize="11" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource ErrorColor}"
                   Margin="0,12,0,0" TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}"/>
    </StackPanel>
</UserControl>
