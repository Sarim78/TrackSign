<UserControl x:Class="TrackSign.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Button Content="← Back" Style="{StaticResource GhostButton}" Foreground="{StaticResource AccentColor}"
                Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>

        <Border Padding="24" Background="{StaticResource CardBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Report.Filename, FallbackValue='Review report'}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,8">
                        <Run Text="Reviewed on "/>
                        <Run Text="{Binding Report.CreatedAt, Mode=OneWay}"/>
                    </TextBlock>
                    <Border BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="12"
                            Padding="10,4" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Report.ContractType}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Copy report" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,8"
                                Command="{Binding CopyReportCommand}" Margin="0,0,8,0"/>
                        <Button Content="Export PDF" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,8"
                                Command="{Binding ExportPdfCommand}" Margin="0,0,8,0"/>
                        <Button Content="Print" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,8"
                                Command="{Binding PrintReportCommand}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="80">
                    <Grid Width="80" Height="80">
                        <Ellipse Width="74" Height="74" Stroke="{StaticResource ChartTrack}" StrokeThickness="6"/>
                        <Ellipse Width="74" Height="74" StrokeThickness="6" StrokeDashCap="Round"
                                 StrokeDashArray="{Binding RiskDashArray}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Stroke" Value="{StaticResource SeverityLow}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RiskTone}" Value="medium">
                                            <Setter Property="Stroke" Value="{StaticResource SeverityMedium}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RiskTone}" Value="high">
                                            <Setter Property="Stroke" Value="{StaticResource SeverityHigh}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding RiskScore}" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Risk score" FontSize="10" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="{StaticResource PanelBackground}" Padding="12,20" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TotalFlags, StringFormat='{}{0} clauses flagged'}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="  |  " Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="{Binding Report.FlagCounts.High, StringFormat='{}{0} high risk'}" FontSize="13" Foreground="{StaticResource SeverityHigh}"/>
                <TextBlock Text="  |  " Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="{Binding Report.FlagCounts.Medium, StringFormat='{}{0} medium'}" FontSize="13" Foreground="{StaticResource SeverityMedium}"/>
                <TextBlock Text="  |  " Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="{Binding Report.FlagCounts.Low, StringFormat='{}{0} low'}" FontSize="13" Foreground="{StaticResource SeverityLow}"/>
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Findings}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                        <StackPanel>
                            <Button Style="{StaticResource LinkCardButton}" Command="{Binding ToggleCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2">
                                        <Border.Background>
                                            <Binding Path="Severity" Converter="{StaticResource SeverityToColor}"/>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,16,8,16">
                                        <TextBlock Text="{Binding Category}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ClausePreview}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Background="{Binding Severity, Converter={StaticResource SeverityToColor}, ConverterParameter=Background}">
                                        <TextBlock Text="{Binding SeverityLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToColor}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="&#xE76C;" Style="{StaticResource Mdl2Icon}" FontSize="12" Margin="0,0,16,0"/>
                                </Grid>
                            </Button>
                            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="56,20,20,20">
                                    <StackPanel>
                                        <TextBlock Text="WHAT IT SAYS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                        <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="2,0,0,0" Padding="16,0,0,0" Margin="0,8,0,20">
                                            <TextBlock Text="{Binding Clause}" FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                        </Border>
                                        <TextBlock Text="WHY IT MATTERS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                        <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="2,0,0,0" Padding="16,0,0,0" Margin="0,8,0,20">
                                            <TextBlock Text="{Binding Explanation}" FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                        </Border>
                                        <TextBlock Text="FAIRER VERSION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}"/>
                                        <Border Background="{StaticResource AccentFillSubtle}" BorderBrush="{StaticResource AccentColor}"
                                                BorderThickness="2,0,0,0" Padding="16,12" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding FairerVersion}" FontSize="13" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="This report does not constitute legal advice. Consult a qualified lawyer."
                   FontSize="11" Foreground="{StaticResource TextMuted}" TextAlignment="Center" Margin="0,24,0,16"/>
    </StackPanel>
</UserControl>
