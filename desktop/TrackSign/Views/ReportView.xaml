<UserControl x:Class="TrackSign.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Button Content="← Back" Style="{StaticResource GhostButton}"
                Foreground="{StaticResource AccentColor}"
                Command="{Binding GoBackCommand}"
                HorizontalAlignment="Left" Margin="0,0,0,20"/>

        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource ErrorColor}"
                   Margin="0,0,0,16"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}"/>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Copy report" Style="{StaticResource SecondaryButton}"
                                    FontSize="12" Padding="12,8" Command="{Binding CopyReportCommand}" Margin="0,0,8,0"/>
                            <Button Content="Download report" Style="{StaticResource SecondaryButton}"
                                    FontSize="12" Padding="12,8" Command="{Binding DownloadReportCommand}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Report.Filename, FallbackValue='Review report'}"
                                       FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0">
                                <Run Text="Reviewed "/>
                                <Run Text="{Binding Report.CreatedAt, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="{Binding TotalFlags, StringFormat='{}{0} flags found'}" FontSize="13"/>
                        <TextBlock Text="  |  " FontSize="13" Foreground="{StaticResource TextDark}"/>
                        <TextBlock Text="{Binding Report.FlagCounts.High, StringFormat='{}{0} high risk'}"
                                   FontSize="13" Foreground="{StaticResource SeverityHigh}"/>
                        <TextBlock Text="  " FontSize="13"/>
                        <TextBlock Text="{Binding Report.FlagCounts.Medium, StringFormat='{}{0} medium'}"
                                   FontSize="13" Foreground="{StaticResource SeverityMedium}"/>
                        <TextBlock Text="  " FontSize="13"/>
                        <TextBlock Text="{Binding Report.FlagCounts.Low, StringFormat='{}{0} low'}"
                                   FontSize="13" Foreground="{StaticResource SeverityLow}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Width="64" Height="64" Margin="24,0,0,0" VerticalAlignment="Top">
                    <Ellipse Width="56" Height="56" Stroke="{StaticResource BorderDefault}" StrokeThickness="4"/>
                    <Ellipse Width="56" Height="56" StrokeThickness="4" StrokeDashCap="Round"
                             StrokeDashArray="{Binding RiskDashArray}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Stroke" Value="{StaticResource SeverityLow}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RiskTone}" Value="medium">
                                        <Setter Property="Stroke" Value="{StaticResource SeverityMedium}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RiskTone}" Value="high">
                                        <Setter Property="Stroke" Value="{StaticResource SeverityHigh}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding RiskScore}" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Text="Findings" Style="{StaticResource SectionHeading}" Margin="0,24,0,16"/>

        <ItemsControl ItemsSource="{Binding Findings}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8"
                            BorderThickness="3,1,1,1"
                            BorderBrush="{Binding Severity, Converter={StaticResource SeverityToColor}}">
                        <StackPanel>
                            <Button Style="{StaticResource LinkCardButton}" Command="{Binding ToggleCommand}">
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="10" Padding="6,3"
                                            Background="{Binding Severity, Converter={StaticResource SeverityToColor}, ConverterParameter=Background}">
                                        <TextBlock Text="{Binding SeverityLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToColor}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="›" FontSize="14" Foreground="{StaticResource TextMuted}"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="WHAT IT SAYS" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding Clause}" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,16"/>
                                        <TextBlock Text="WHY IT MATTERS" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding Explanation}" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,8,0,16"/>
                                        <TextBlock Text="FAIRER VERSION" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentColor}"/>
                                        <TextBlock Text="{Binding FairerVersion}" FontSize="13"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,24,0,0">
            <TextBlock Text="TrackSign does not provide legal advice. This report flags terms worth reviewing with a qualified lawyer."
                       FontSize="11" Foreground="{StaticResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap"/>
        </Border>
    </StackPanel>
</UserControl>
