<UserControl x:Class="TrackSign.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <TextBlock Text="{Binding UserName, StringFormat='Welcome back, {0}'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Here is an overview of your contract reviews." Style="{StaticResource PageSubtitle}"/>

            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource ErrorColor}" Margin="0,0,0,16"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}"/>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL REVIEWS" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding TotalReviews}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBlock Text="No data yet" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="HIGH RISK FLAGS" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding HighRiskFlags}" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{StaticResource SeverityHigh}" Margin="0,8,0,4"/>
                        <Border Height="20" Width="60" Background="{StaticResource ChartTrack}" CornerRadius="2" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="CONTRACTS THIS MONTH" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding ContractsThisMonth}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding MonthComparison}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="AVG RISK SCORE" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding AverageRiskDisplay}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,4"
                                   Foreground="{StaticResource TextMuted}"/>
                        <Ellipse Width="36" Height="20" Stroke="{StaticResource ChartTrack}" StrokeThickness="3"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Height="200">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <ComboBox DockPanel.Dock="Right" Style="{StaticResource DarkComboBox}" Width="140"
                                      ItemsSource="{Binding ActivityRanges}" SelectedItem="{Binding ActivityRange}"/>
                            <TextBlock Text="Review activity" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="No activity yet" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        <ItemsControl ItemsSource="{Binding WeekBars}"
                                      Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border Width="24" Height="{Binding Height}" CornerRadius="3,3,0,0"
                                                Background="{StaticResource AccentColor}" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{StaticResource TextMuted}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Height="200">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Risk distribution" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="No data yet" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasDistribution, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        <StackPanel Visibility="{Binding HasDistribution, Converter={StaticResource BoolToVis}}">
                            <Grid Height="16" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource SeverityHigh}" CornerRadius="4,0,0,4"/>
                                <Border Grid.Column="1" Background="{StaticResource SeverityMedium}"/>
                                <Border Grid.Column="2" Background="{StaticResource SeverityLow}" CornerRadius="0,4,4,0"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SeverityHigh}" Margin="0,0,8,0"/>
                                <TextBlock Text="High risk" FontSize="12" Foreground="{StaticResource TextSecondary}" Width="100"/>
                                <TextBlock Text="{Binding DistHigh}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SeverityMedium}" Margin="0,0,8,0"/>
                                <TextBlock Text="Medium risk" FontSize="12" Foreground="{StaticResource TextSecondary}" Width="100"/>
                                <TextBlock Text="{Binding DistMedium}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SeverityLow}" Margin="0,0,8,0"/>
                                <TextBlock Text="Low risk" FontSize="12" Foreground="{StaticResource TextSecondary}" Width="100"/>
                                <TextBlock Text="{Binding DistLow}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,16,20,0">
                        <Button DockPanel.Dock="Right" Content="View all" Style="{StaticResource GhostButton}"
                                Foreground="{StaticResource AccentColor}" Command="{Binding ViewHistoryCommand}"/>
                        <TextBlock Text="Recent reviews" FontSize="14" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,12,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CONTRACT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="TYPE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Column="2" Text="FLAGS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Column="3" Text="RISK SCORE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Column="4" Text="DATE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderDefault}" Margin="20,8,20,0"/>

                    <StackPanel Visibility="{Binding HasRecentReviews, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" Margin="20,32">
                        <TextBlock Text="No reviews yet. Upload a contract to get started." FontSize="13"
                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding RecentRows}"
                                  Visibility="{Binding HasRecentReviews, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="44" Margin="20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Filename}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ContractType}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FlagCounts.High}" Foreground="{StaticResource SeverityHigh}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding FlagCounts.Medium}" Foreground="{StaticResource SeverityMedium}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding FlagCounts.Low}" Foreground="{StaticResource SeverityLow}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding RiskScore}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding RelativeDate}" FontSize="12"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="5" Content="View" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.OpenReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding ReviewId}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE9D9;" Style="{StaticResource Mdl2Icon}" FontSize="32"/>
            <TextBlock Text="Loading dashboard..." FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
