<UserControl x:Class="TrackSign.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32">
        <StackPanel>
            <TextBlock Text="{Binding UserName, StringFormat='Welcome back, {0}'}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Review activity across your organization."
                       Style="{StaticResource MutedText}" Margin="0,6,0,24"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource HighSeverityBrush}" Margin="0,0,0,16"/>

            <UniformGrid Columns="3" Margin="0,0,0,24">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total reviews" Style="{StaticResource MutedText}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalReviews}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="High-risk flags" Style="{StaticResource MutedText}" FontSize="12"/>
                        <TextBlock Text="{Binding HighRiskFlags}" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{StaticResource HighSeverityBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="This month" Style="{StaticResource MutedText}" FontSize="12"/>
                        <TextBlock Text="{Binding ContractsThisMonth}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Upload a contract"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartUploadCommand}"/>
                <TextBlock Text="Recent reviews" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding RecentReviews}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource LinkCardButton}"
                                Command="{Binding DataContext.OpenReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding ReviewId}">
                            <ContentPresenter Content="{Binding}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No reviews yet. Upload a contract to get started."
                       Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentReviews.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
