<UserControl x:Class="TrackSign.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding UserName, StringFormat='Welcome back, {0}'}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Here is an overview of your contract reviews." Style="{StaticResource PageSubtitle}"/>

        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource ErrorColor}"
                   Margin="0,0,0,16"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVis}}"/>

        <UniformGrid Columns="4" Margin="0,0,0,24">
            <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="TOTAL REVIEWS" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding TotalReviews}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="HIGH RISK FLAGS" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding HighRiskFlags}" FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource SeverityHigh}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="CONTRACTS THIS MONTH" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding ContractsThisMonth}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="RISK SCORE (AVG)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding AverageRiskDisplay}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRiskScore}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Text="Quick actions" Style="{StaticResource SectionHeading}"/>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource LinkCardButton}" Command="{Binding StartUploadCommand}">
                <Border Style="{StaticResource HoverCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Upload a new contract" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Drop a PDF and get your review in under 60 seconds."
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="→" FontSize="16" Foreground="{StaticResource AccentColor}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </Border>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource LinkCardButton}" Command="{Binding ViewHistoryCommand}">
                <Border Style="{StaticResource HoverCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="View review history" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Browse all your past contract reviews."
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="→" FontSize="16" Foreground="{StaticResource AccentColor}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </Border>
            </Button>
        </Grid>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="View all →" Style="{StaticResource GhostButton}"
                    Foreground="{StaticResource AccentColor}" Command="{Binding ViewHistoryCommand}"/>
            <TextBlock Text="Recent reviews" Style="{StaticResource SectionHeading}" Margin="0"/>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding RecentReviews}"
                      Visibility="{Binding HasRecentReviews, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource LinkCardButton}"
                            Command="{Binding DataContext.OpenReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding ReviewId}">
                        <ContentPresenter Content="{Binding}"/>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource Card}" Padding="48"
                Visibility="{Binding HasRecentReviews, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="No contracts reviewed yet" FontSize="14" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Upload your first contract to get started" FontSize="12"
                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,16"/>
                <Button Content="Upload contract" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartUploadCommand}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
